# Database (gateway only — agent is stateless/in-memory)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel

# Gateway
GATEWAY_PORT=3001
AGENT_URL=http://localhost:3002

# Agent
AGENT_PORT=3002
GATEWAY_URL=http://localhost:3001
NASA_API_KEY=DEMO_KEY
ANTHROPIC_API_KEY=

# Auth
# API_KEY — required in production for public API access (x-api-key header)
# In development (NODE_ENV=development), public API auth is bypassed.
API_KEY=sentinel-dev-api-key
# INTERNAL_SECRET — always required for agent→gateway communication (x-internal-secret header)
INTERNAL_SECRET=orbit-sentinel-internal-dev-key
