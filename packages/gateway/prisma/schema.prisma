generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model AgentSnapshot {
    id           String   @id @default(uuid())
    score        Int
    level        String
    breakdown    Json
    brief        Json?
    spaceWeather Json
    flares       Json
    cmes         Json
    neos         Json
    eonetEvents  Json     @default("[]")
    timestamp    DateTime @default(now())

    @@index([timestamp(sort: Desc)])
    @@index([level])
    @@map("agent_snapshots")
}

model AlertRecord {
    id        String   @id @default(uuid())
    level     String
    score     Int
    brief     String
    riskState Json
    timestamp DateTime @default(now())

    @@index([timestamp(sort: Desc)])
    @@index([level])
    @@map("alert_records")
}

model SpaceWeatherReading {
    id             String   @id @default(uuid())
    xrayClass      String?
    kpIndex        Float?
    protonFlux     Float?
    solarWindSpeed Float?
    bz             Float?
    timestamp      DateTime @default(now())

    @@index([timestamp(sort: Desc)])
    @@map("space_weather_readings")
}

model SatelliteRiskAlert {
    id        String   @id @default(uuid())
    noradId   Int
    name      String
    regime    String
    riskScore Int
    riskLevel String
    prevLevel String
    threats   String[]
    timestamp DateTime @default(now())

    @@index([noradId, timestamp(sort: Desc)])
    @@index([riskLevel, timestamp(sort: Desc)])
    @@map("satellite_risk_alerts")
}

model ConjunctionEvent {
    id                   String   @id @default(uuid())
    sat1NoradId          Int
    sat1Name             String
    sat2NoradId          Int
    sat2Name             String
    distanceKm           Float
    severity             String
    isIntraConstellation Boolean
    sat1Regime           String
    sat2Regime           String
    sat1Position         Json
    sat2Position         Json
    timestamp            DateTime @default(now())

    @@index([sat1NoradId, timestamp(sort: Desc)])
    @@index([sat2NoradId, timestamp(sort: Desc)])
    @@index([severity, timestamp(sort: Desc)])
    @@index([timestamp(sort: Desc)])
    @@map("conjunction_events")
}
