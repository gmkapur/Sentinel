datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model SpaceWeatherReading {
    id          String   @id @default(cuid())
    source      String
    data        Json
    processedAt DateTime @default(now())

    @@index([source, processedAt(sort: Desc)])
}

model DonkiFlare {
    id             String    @id @default(cuid())
    flrID          String    @unique
    classType      String
    beginTime      DateTime
    peakTime       DateTime
    endTime        DateTime?
    sourceLocation String
    fetchedAt      DateTime  @default(now())

    @@index([peakTime(sort: Desc)])
}

model DonkiCME {
    id         String   @id @default(cuid())
    activityID String   @unique
    startTime  DateTime
    speed      Float?
    type       String
    fetchedAt  DateTime @default(now())

    @@index([startTime(sort: Desc)])
}

model NeoObject {
    id                     String   @id @default(cuid())
    neoId                  String   @unique
    name                   String
    estimatedDiameter      Float
    isPotentiallyHazardous Boolean
    closeApproachDate      DateTime
    missDistanceKm         Float
    relativeVelocityKmS    Float
    fetchedAt              DateTime @default(now())

    @@index([closeApproachDate(sort: Desc)])
}

model EonetEvent {
    id          String   @id @default(cuid())
    eventId     String   @unique
    title       String
    category    String
    source      String
    link        String?
    date        DateTime
    coordinates Json?
    fetchedAt   DateTime @default(now())
}

model RiskAssessment {
    id        String   @id @default(cuid())
    score     Int
    level     String
    breakdown Json
    createdAt DateTime @default(now())

    @@index([createdAt(sort: Desc)])
}

model MissionBrief {
    id              String   @id @default(cuid())
    recommendation  String
    summary         String
    threats         Json
    maneuverWindows Json
    confidence      Float
    isLlm           Boolean
    generatedAt     DateTime @default(now())

    @@index([generatedAt(sort: Desc)])
}

model PollStatus {
    source       String   @id
    lastPollAt   DateTime
    lastSuccess  Boolean
    errorMessage String?
}
